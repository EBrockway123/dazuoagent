# Backend env. Copy to backend/.env and fill in.
# Loaded by `pydantic-settings` (see backend/src/dazuoagent/core/config.py).

ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000
RELOAD=true

# SQLite default — switch to postgresql+psycopg://user:pwd@host:5432/dazuoagent in prod.
# DATABASE_URL=sqlite:///../../data/db/dazuoagent.sqlite

# CORS — comma-separated origins. Defaults already include the Vite dev server.
# CORS_ORIGINS=["http://localhost:5173"]

# LLM provider. "mock" returns stubbed replies; flip to openai / anthropic /
# deepseek once the corresponding API key is set.
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# DeepSeek (OpenAI-compatible surface, https://api.deepseek.com/v1)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
